# ============================================================
# D&R Perícia Elite — Frontend
# Copie para .env.local e ajuste. O arquivo .env já é ignorado.
# ============================================================

# mock → navega com dados de demonstração, sem servidor
# rest → conversa com a API
VITE_API_MODE=rest

# Deixe vazio em desenvolvimento: o proxy do Vite encaminha /api
# para o backend, mantendo o cookie de sessão como same-site.
# Em produção, informe a URL pública da API (ex.: https://api.drpericiaelite.com.br).
VITE_API_URL=

# Só o proxy de desenvolvimento. Mude se a API não estiver na 3333.
VITE_API_PROXY=http://localhost:3333
