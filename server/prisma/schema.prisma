// ============================================================
// D&R Perícia Elite — Modelo de dados (PostgreSQL)
//
// Espelha src/types/index.ts do frontend. Regra geral:
//   · datas do domínio (admissão, vistoria) são String "YYYY-MM-DD",
//     como vêm dos <input type="date"> — evita bugs de fuso;
//   · timestamps do sistema são DateTime e o mapper os recorta
//     para "YYYY-MM-DD" na resposta;
//   · o preenchimento técnico do parecer é um documento redacional,
//     não uma entidade consultável — fica em Json.
// ============================================================

generator client {
  provider = "prisma-client-js"
  // O node:22-bookworm-slim nao traz o libssl, entao a deteccao do
  // OpenSSL falha no estagio de build e o Prisma cai no default
  // "debian-openssl-1.1.x". No runtime o Chromium instala o libssl3
  // e o cliente gerado nao acha o Query Engine correspondente:
  //   "could not locate the Query Engine for runtime debian-openssl-3.0.x"
  // Declarar o alvo explicitamente tira a deteccao do caminho.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Módulo A — Acesso ----------------

enum Perfil {
  admin
  perito
  assistente
}

model Usuario {
  id                   String    @id @default(uuid())
  nome                 String
  email                String    @unique
  senhaHash            String
  perfil               Perfil    @default(assistente)
  registroProfissional String?
  titulo               String?
  telefone             String?
  ativo                Boolean   @default(true)
  ultimoAcesso         DateTime?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  pericias   Pericia[]
  textos     TextoBiblioteca[]
  quesitos   Quesito[]
  documentos DocumentoGerado[]

  @@map("usuarios")
}

// ---------------- Módulo B — Empresas ----------------

model Empresa {
  id              String   @id @default(uuid())
  razaoSocial     String
  nomeFantasia    String?
  cnpj            String   @unique
  cnae            String?
  grauRisco       String?
  endereco        String   @default("")
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String   @default("")
  uf              String   @default("SP")
  cep             String?
  contatoNome     String?
  contatoEmail    String?
  contatoTelefone String?
  ramoAtividade   String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  reclamadas Reclamada[]

  @@map("empresas")
}

// ---------------- Módulos C/D/E — Perícias ----------------

enum Modalidade {
  insalubridade
  periculosidade
  ambas
}

enum StatusPericia {
  rascunho
  em_andamento
  concluida
  entregue
}

model Pericia {
  id               String        @id @default(uuid())
  numeroProcesso   String        @default("")
  vara             String        @default("")
  comarca          String        @default("")
  reclamante       String        @default("")
  cpfReclamante    String?
  funcaoReclamante String?

  /// Marco de onde se contam os cinco anos do periodo avaliado.
  dataAjuizamento String?

  admissao String?
  demissao String?
  dataVistoria     String?
  horaVistoria     String?
  localVistoria    String?
  modalidade       Modalidade    @default(insalubridade)
  status           StatusPericia @default(rascunho)

  /// PreenchimentoTecnico completo (12 campos de texto + periodos[] + agentes[]).
  tecnico Json

  responsavelId String
  responsavel   Usuario @relation(fields: [responsavelId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  reclamadas    Reclamada[]
  participantes Participante[]
  fotos         Foto[]
  documentos    DocumentoGerado[]

  @@index([responsavelId])
  @@index([numeroProcesso])
  @@map("pericias")
}

model Reclamada {
  id        String  @id @default(uuid())
  periciaId String
  empresaId String
  principal Boolean @default(false)

  pericia Pericia @relation(fields: [periciaId], references: [id], onDelete: Cascade)
  // Restrict: uma empresa já citada como reclamada não pode sumir do histórico.
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([periciaId])
  @@index([empresaId])
  @@map("reclamadas")
}

enum PapelParticipante {
  perito_judicial
  reclamante
  engenheiro_assistente_reclamante
  tecnico_assistente_reclamante
  assistente_reclamante
  engenheiro_assistente_reclamada
  tecnico_assistente_reclamada
  assistente_reclamada
  advogado_reclamante
  advogado_reclamada
  preposto
  auxiliar_perito
  paradigma
  entrevistado
  acompanhante
}

model Participante {
  id        String            @id @default(uuid())
  periciaId String
  nome      String            @default("")
  papel     PapelParticipante
  registro  String?
  contato   String?

  pericia Pericia @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@index([periciaId])
  @@map("participantes")
}

enum SecaoFoto {
  ambiente
  atividades
  equipamentos
  epi
  produtos
  documentos
}

model Foto {
  id        String    @id @default(uuid())
  periciaId String
  secao     SecaoFoto
  /// Nome do arquivo no volume de uploads — a URL pública é montada no mapper.
  arquivo   String
  legenda   String    @default("")
  ordem     Int       @default(0)
  criadoEm  DateTime  @default(now())

  pericia Pericia @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@index([periciaId])
  @@map("fotos")
}

// ---------------- Módulo F — Biblioteca de textos ----------------

enum SecaoTexto {
  apresentacao
  objetivo
  empresa
  ambiente
  atividades
  analise
  conclusao
  manifestacao
  impugnacao
  esclarecimento
  generico
}

model TextoBiblioteca {
  id             String          @id @default(uuid())
  usuarioId      String
  titulo         String
  secao          SecaoTexto      @default(generico)
  tiposDocumento TipoDocumento[] @default([])
  tags           String[]        @default([])
  conteudo       String
  favorito       Boolean         @default(false)
  usos           Int             @default(0)
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("textos_biblioteca")
}

// ---------------- Módulo K — Quesitos ----------------

enum TemaQuesito {
  gerais
  insalubridade
  periculosidade
  ruido
  calor
  quimicos
  biologicos
  epi
  ergonomia
  eletricidade
  inflamaveis
}

enum OrigemQuesito {
  juizo
  reclamante
  reclamada
  proprio
}

model Quesito {
  id             String        @id @default(uuid())
  /// null = quesito do banco global (os 39 pré-cadastrados).
  usuarioId      String?
  codigo         String
  tema           TemaQuesito
  origem         OrigemQuesito
  pergunta       String
  respostaPadrao String?
  favorito       Boolean       @default(false)
  usos           Int           @default(0)
  personalizado  Boolean       @default(false)
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("quesitos")
}

// ---------------- Módulos G/H/I/J — Documentos ----------------

enum TipoDocumento {
  parecer
  laudo
  quesitos
  manifestacao
  impugnacao
  esclarecimento
}

enum StatusDocumento {
  rascunho
  finalizado
  enviado
}

model DocumentoGerado {
  id               String          @id @default(uuid())
  tipo             TipoDocumento
  titulo           String
  /// null quando o documento é emitido sem vínculo com processo.
  periciaId        String?
  numeroProcesso   String          @default("—")
  reclamante       String          @default("—")
  empresaPrincipal String          @default("—")
  status           StatusDocumento @default(rascunho)

  /// Estado editável do documento: quesitos respondidos, blocos da
  /// manifestação, pontos do esclarecimento. É o que permite reabrir.
  conteudo Json?

  anexoExternoNome    String?
  anexoExternoArquivo String?
  enviadoPara         String?
  enviadoEm           DateTime?

  criadoPorId String
  criadoPor   Usuario  @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  pericia     Pericia? @relation(fields: [periciaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([periciaId])
  @@index([criadoPorId])
  @@map("documentos")
}

model EpiCatalogo {
  id                String   @id @default(uuid())
  chave             String   @unique
  modelo            String
  marca             String
  caUnico           String?
  caPecaFacial      String?
  caFiltroCartucho  String?
  nivelProtecaoDb   Float?
  metodoAtenuacao   String?
  observacao        String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  aplicacoes        EpiAplicacao[]

  @@map("epis_catalogo")
}

model EpiAplicacao {
  id        String @id @default(uuid())
  epiId     String
  anexo     String
  categoria String
  epi       EpiCatalogo @relation(fields: [epiId], references: [id], onDelete: Cascade)

  @@unique([epiId, anexo, categoria])
  @@index([anexo, categoria])
  @@map("epis_aplicacoes")
}



// ---------------- Módulo L — Espelho oficial do CAEPI/MTE ----------------
//
// Três tabelas com donos diferentes, e é essa separação que sustenta
// a promessa feita ao perito:
//
//   · cas_oficiais   → cópia do que o MTE publica. A sincronização
//                      reescreve à vontade;
//   · cas_atenuacao  → o NRRsf. A sincronização do CSV não escreve
//                      nesta tabela em momento nenhum, então nenhuma
//                      atualização do MTE consegue apagar o que foi
//                      preenchido à mão;
//   · epis_catalogo  → curadoria do perito, o que ele escolheu usar
//                      nas perícias. A sincronização nunca toca.
//
// Grão de cas_oficiais: (numeroCa, processo), não o número do CA
// sozinho. A base repete o mesmo CA uma vez por norma técnica —
// 124.067 linhas para 42.321 CAs — mas 22 CAs têm de fato mais de um
// processo de homologação, com validades diferentes. Como a perícia
// pergunta "esse CA valia na data X", esses 22 casos precisam existir
// separados; as normas repetidas viram lista.

model CaOficial {
  numeroCa String
  processo String

  dataValidade String?
  situacao     String
  cnpj         String?
  razaoSocial  String?
  natureza     String?
  equipamento  String
  descricao    String?
  marca        String?
  referencia   String?
  cor          String?

  aprovadoParaLaudo String?
  restricaoLaudo    String?
  observacaoLaudo   String?

  /// Normas técnicas de ensaio, agregadas das linhas repetidas do CSV.
  normas String[]
  /// [{ numero, cnpjLaboratorio, razaoLaboratorio }]
  laudos Json     @default("[]")

  // De-para para a NR-15, derivado de "equipamento"
  categoria     String
  anexos        String[]
  exigeNrrsf    Boolean  @default(false)
  descontinuado Boolean  @default(false)

  sincronizadoEm DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@id([numeroCa, processo])
  @@index([numeroCa])
  @@index([equipamento])
  @@index([situacao])
  @@index([marca])
  @@index([exigeNrrsf])
  @@map("cas_oficiais")
}

// Atenuação sonora do CA. Fica fora de cas_oficiais por dois motivos:
// é atributo do número do CA (não da homologação), e é o único dado
// do módulo que pode vir do perito. Tabela separada = a sincronização
// não tem como sobrescrever, nem por engano.
model CaAtenuacao {
  numeroCa String @id

  /// NRR subject fit, em dB. Não existe no CSV: sai da ficha individual.
  nrrsfDb Float?
  /// "CAEPI" quando veio da ficha do MTE, "PERITO" quando foi digitado.
  fonte      String
  /// Atenuação por banda de oitava: { "125": 12.4, "250": 15.1, ... }
  bandas     Json?
  observacao String?

  fichaConsultadaEm DateTime?
  atualizadoEm      DateTime  @updatedAt

  @@index([fonte])
  @@map("cas_atenuacao")
}

model CaepiSincronizacao {
  id          String    @id @default(uuid())
  iniciadoEm  DateTime  @default(now())
  concluidoEm DateTime?
  status      String
  origem      String    @default("agendada")

  registrosLidos       Int @default(0)
  registrosNovos       Int @default(0)
  registrosAtualizados Int @default(0)
  fichasConsultadas    Int @default(0)

  erro String?

  @@index([iniciadoEm])
  @@map("caepi_sincronizacoes")
}
