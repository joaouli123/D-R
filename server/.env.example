# ============================================================
# D&R Perícia Elite — API
# Copie para .env e preencha. Nunca versione o .env preenchido.
# ============================================================

NODE_ENV=development
PORT=3333

# ---------- Banco ----------
DATABASE_URL="postgresql://dr:senha-forte@localhost:5432/dr_pericia?schema=public"

# ---------- Sessão ----------
# Mínimo 32 caracteres. Gere com:  openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"
JWT_EXPIRACAO=8h

# ---------- Frontend ----------
# Origens autorizadas, separadas por vírgula. Precisa bater com a
# URL de onde o frontend é servido, senão o navegador bloqueia.
CORS_ORIGINS=http://localhost:5173

# URL pública desta API — usada para montar o endereço das fotos.
API_PUBLIC_URL=http://localhost:3333

# ---------- Uploads ----------
# Em produção aponte para um volume persistente.
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=15

# ---------- PDF ----------
# Em desenvolvimento deixe vazio (o Puppeteer usa o Chromium que
# ele mesmo baixa). No container aponte para o Chromium do sistema:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# ---------- E-mail (Módulo I) ----------
# A API REST é preferencial. SMTP fica como fallback opcional.
BREVO_API_KEY=
# Credenciais do relay SMTP transacional da Brevo. A senha SMTP começa
# com "xsmtpsib-" e não deve ser confundida com a API key REST.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
EMAIL_REMETENTE="D&R Perícia <nao-responda@drpericiatrabalhista.com.br>"

# ---------- Seed ----------
# Usados só por `npm run seed`, na primeira carga.
ADMIN_NOME="Dinoel R. Santos"
ADMIN_EMAIL=dinoel@drpericiaelite.com.br
ADMIN_SENHA=
ADMIN_REGISTRO="CREA-SP 0000000000"

# true popula uma empresa e uma perícia de demonstração.
SEED_DEMO=false
